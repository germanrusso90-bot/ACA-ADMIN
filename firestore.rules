rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function verified() { return request.auth != null && request.auth.token.email_verified == true; }
  function admin() { return verified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true; }
  function approved() { return verified() && exists(/databases/$(database)/documents/access/$(request.auth.uid)) && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.enabled == true; }
  function ownCR() { return get(/databases/$(database)/documents/access/$(request.auth.uid)).data.cr; }
  function validCR(cr) { return cr in ['3531','3611','9954','3492','3468','8460','4502','6785','9482','3255','6092','8591','8605','5967']; }
  function config(id) { return id.matches('cr[0-9]{4}--economic--versions.*'); }
  function ownKey(id) { return approved() && id.matches('cr' + ownCR() + '--.*'); }
  function legacy(id) { return approved() && ownCR() == '3531' && !id.matches('cr[0-9]{4}--.*'); }
  match /admins/{uid} {
   allow get: if verified() && request.auth.uid == uid;
   allow list, create, update, delete: if false; // Initial administrator: Firebase Console only.
  }
  match /accessRequests/{uid} {
   allow get: if verified() && (request.auth.uid == uid || admin());
   allow list: if admin();
   allow create: if verified() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['uid','email','cr','status','createdAt'])
    && request.resource.data.uid == uid
    && request.resource.data.email == request.auth.token.email
    && validCR(request.resource.data.cr)
    && request.resource.data.status == 'pending'
    && request.resource.data.createdAt is number;
   allow update: if admin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
    && request.resource.data.status in ['approved','rejected']
    && request.resource.data.reviewedBy == request.auth.uid;
   allow delete: if false;
  }
  match /access/{uid} {
   allow get: if verified() && (request.auth.uid == uid || admin());
   allow list: if admin();
   // The administrator cannot grant or move their own station access: that
   // would give them the general read access they must not have.
   allow create, update: if admin()
    && uid != request.auth.uid
    && request.resource.data.keys().hasOnly(['email','cr','enabled','approvedBy','updatedAt'])
    && request.resource.data.email is string
    && request.resource.data.enabled is bool
    && request.resource.data.approvedBy == request.auth.uid
    && validCR(request.resource.data.cr);
   allow delete: if false;
  }
  // Previous versions and file fragments are write-once. An identical retry of
  // a write that already landed is accepted; any change is rejected.
  function immutableCopy(id) { return id.matches('.*--(chunk|part|backup)--.*'); }
  // Shapes written by storage.js: values up to 700,000 characters (larger ones
  // are fragmented) and fragments of 480,000 bytes in base64.
  function kvShape(id, d) {
   return (id.matches('.*--chunk--.*')
     && d.keys().hasOnly(['k','chunk','revision','index'])
     && d.chunk is string && d.chunk.size() <= 640000)
    || (!id.matches('.*--chunk--.*') && immutableCopy(id) && d.keys().size() <= 16)
    || (!immutableCopy(id)
     && d.keys().hasOnly(['v','k','updatedAt','chunked','revision','count','bytes','sha256'])
     && (!('v' in d) || d.v == null || (d.v is string && d.v.size() <= 700000))
     && (!('count' in d) || (d.count is int && d.count >= 1 && d.count <= 200)));
  }
  function canWriteKv(id) { return (admin() && config(id)) || (ownKey(id) && !config(id)); }
  match /kv/{id} {
   allow get: if ownKey(id) || legacy(id) || (admin() && config(id));
   allow list: if false;
   allow create: if canWriteKv(id) && kvShape(id, request.resource.data);
   allow update: if canWriteKv(id) && kvShape(id, request.resource.data)
    && (!immutableCopy(id) || request.resource.data == resource.data);
   allow delete: if false;
  }
 }
}
